# URL publique, utilisée pour les métadonnées, le sitemap et robots.txt.
NEXT_PUBLIC_SITE_URL=https://fileo.app

# Connexion MongoDB Atlas. Ne jamais versionner les valeurs réelles.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB=fileo

# Vérification du téléphone (§7.1 AUTH-01) — aucun fournisseur n'est encore
# retenu. À renseigner avant d'ouvrir les inscriptions au public.
# SMS_PROVIDER=
# SMS_API_KEY=

# Destinataire des demandes d'assistance (§13.3).
# SUPPORT_TO=support@fileo.app
