# Contournement local : registry.npmjs.org est bloqué (HTTP 403) par le filtrage
# réseau de ce poste. Ce miroir tiers sert les mêmes paquets, métadonnées et
# tarballs inclus.
#
# À SUPPRIMER dès que registry.npmjs.org est accessible ou qu'un registre
# interne d'entreprise est disponible. Ne pas committer tel quel sur un dépôt
# partagé : ce réglage s'appliquerait à toute l'équipe.
registry=https://registry.npmmirror.com
fund=false
audit=false
