# URL publique Supabase. Valeur publique, aussi utilisee au build Docker.
NEXT_PUBLIC_SUPABASE_URL=

# Cle anon Supabase. Valeur publique, aussi utilisee au build Docker.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cle service role Supabase. Secret serveur uniquement.
SUPABASE_SERVICE_ROLE_KEY=

# Connexion Postgres Supabase. Preferer l'URL pooler en production.
SUPABASE_POOLER_DB_URL=
SUPABASE_DB_URL=

# Bucket Storage prive utilise par Fileo.
SUPABASE_STORAGE_PRIVATE_BUCKET=fileo

# Base URL publique du web/API. Sans domaine, utiliser http://IP_DU_VPS.
NEXT_PUBLIC_APP_URL=

# Paiement MTN MoMo, a renseigner seulement si active en production.
MOMO_BASE_URL=
MOMO_COLLECTION_PRIMARY_KEY=
MOMO_COLLECTION_SECONDARY_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=
MOMO_CALLBACK_URL=
